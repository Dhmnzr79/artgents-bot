      "must_contain": ["гарант"],
      "comment": "IMPLANT #1+#15: price + warranty facet",
      "testability": "medium"
    },
    {
      "id": "planner_duration_pain",
      "client_id": "demo",
      "question": "Сколько по времени длится протезирование на имплантах и больно ли это?",
      "expected_route_any": ["retrieval_chunk", "catalog_md_first"],
      "expected_plan_aspects": ["duration", "pain"],
      "expected_packet_aspects": ["duration", "pain"],
      "require_answer_packet": true,
      "must_contain": ["срок", "боль"],
      "comment": "duration + pain composite",
      "testability": "medium"
    },
    {
      "id": "planner_one_stage_price_payment",
