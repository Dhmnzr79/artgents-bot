[Unit]
Description=Artgents scheduled PostgreSQL backup (G7)
Documentation=file:///opt/artgents/current/deploy/production/server/README.md
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/artgents/bin/backup-postgres --reason scheduled
TimeoutStartSec=3600
Nice=10

[Install]
WantedBy=multi-user.target
