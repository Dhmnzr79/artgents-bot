      "expected_route_any": ["retrieval_chunk", "catalog_md_first", "price_lookup"],
      "must_contain": ["рассроч"],
      "comment": "IMPLANT #6+#8 all-on composite",
      "testability": "medium"
    },
    {
      "id": "planner_followup_classic_installment",
      "client_id": "demo",
      "history": [{"question": "Расскажите про классическую имплантацию"}],
      "question": "а рассрочка есть?",
