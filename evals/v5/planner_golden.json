      "testability": "medium"
    },
    {
      "id": "planner_lead_paused_price_payment",
      "client_id": "demo",
      "history": [
        {"question": "Хочу записаться на имплантацию"},
        {"question": "Мария"}
      ],
      "question": "Подождите, сколько стоит имплант и есть рассрочка?",
