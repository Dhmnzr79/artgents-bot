{
  "baseline": 10,
  "description": "Planner-lite golden (PRODUCT_WORK_PLAN stage 4b): composite price+payment, turnkey, warranty, duration+pain, follow-up, lead paused; 2 negative topic changes.",
  "known_failures": [
    "planner_turnkey_included",
    "planner_price_warranty",
    "planner_comparison_all_on"
  ],
  "cases": [
    {
      "id": "planner_price_installment_classic",
      "client_id": "demo",
      "question": "Сколько стоит классическая имплантация с коронкой и есть ли рассрочка?",
      "expected_route_any": ["retrieval_chunk", "catalog_md_first", "price_lookup"],
      "expected_plan_aspects": ["price", "payment"],
      "expected_packet_aspects": ["price", "payment"],
      "expected_packet_card_kinds": ["price", "payment"],
      "require_answer_packet": true,
      "must_contain": ["рассроч", "оплат"],
      "comment": "IMPLANT #1+#8 composite: price + payment_terms append",
      "testability": "strong"
    },
    {
      "id": "planner_turnkey_included",
      "client_id": "demo",
      "question": "Цена на имплант под ключ или абатмент и коронка отдельно?",
      "expected_route_any": ["retrieval_chunk", "catalog_md_first", "price_lookup"],
      "must_contain": ["ключ", "входит"],
      "comment": "IMPLANT #2: turnkey / included",
      "testability": "medium"
    },
    {
      "id": "planner_price_warranty",
      "client_id": "demo",
      "question": "Сколько стоит поставить имплант и какая у вас гарантия?",
