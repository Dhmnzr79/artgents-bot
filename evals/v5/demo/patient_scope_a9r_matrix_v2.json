{
  "schema_version": "a9r.patient_scope_authority_prep.v2",
  "client_id": "demo",
  "purpose": "Frozen A9R authority-prep expectations: planner patient_scope projection to EffectiveScope merge semantics. Does not replace or modify v1/v2 shadow matrices.",
  "authority_decision_allowed": false,
  "product_path_allowed": false,
  "baseline_product_head": "aa8e6dd",
  "immutable_prior_artifacts": [
    "evals/v5/demo/patient_scope_shadow_matrix.json",
    "evals/v5/demo/patient_scope_shadow_matrix_v2.json",
    "docs/evidence/a9/PATIENT_SCOPE_SHADOW_AUDIT_A9.md",
    "evals/v5/demo/patient_scope_a9r_matrix.json"
  ],
  "allowed_axes": {
    "extent": [
      "unknown",
      "one_tooth",
      "few_teeth",
      "full_arch"
    ],
    "jaw": [
      "unknown",
      "upper",
      "lower",
      "both"
    ],
    "stage": [
      "unknown",
      "natural_tooth_present",
      "extraction_context",
      "implant_placed"
    ],
    "modifiers": [
      "reported_bone_deficit"
    ]
  },
  "merge_contract": {
    "source_priority": [
      "ui_scope_action",
      "ui_stage_action",
      "current_turn_patient_scope",
      "session_patient_facts",
      "unknown"
    ],
    "session_write_requires": "confident_current_turn_extraction",
    "correction_replaces_session": true,
    "uncertain_or_conflicting_must_not_overwrite_session": true,
    "topic_change_clears_session": true,
    "sid_isolation": true
  },
  "scoring_contract": {
    "primary_target": "effective_scope_projection",
    "shadow_frame_reference": "turn_frame.patient_scope",
    "session_behavior_scored": true,
    "planner_reuse_only": true,
    "no_second_llm": true,
    "no_regex_scope_parser": true,
    "no_service_name_scope_inference": true,
    "live_eval_gate": "A9R2",
    "offline_eval_gate": "A9R1"
  },
  "cases": [
    {
      "id": "a9r_extent_01_full_arch_price_question",
      "category": "extent_positive",
      "phase": "a9r2_live",
      "topic": "implantation",
      "question": "Сколько стоит имплантация всей челюсти?",
      "expected_effective_scope": {
        "extent": "full_arch",
        "jaw": "unknown",
        "stage": "unknown",
        "modifiers": []
      },
      "forbidden_inferences": [
        "service_id",
        "all_on_4",
        "all_on_6"
      ],
      "session_write": "optional_if_confident",
      "rationale": "Explicit full-jaw implantation price question states arch scale; does not select protocol."
    },
    {
