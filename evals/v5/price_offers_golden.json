      "expected_service_id": "classic",
      "expected_price_offer_brands": ["Nobel Biocare"],
      "answer_signals_any": ["101 200", "nobel", "₽"],
      "forbidden_signals": ["76 200"],
      "expected_price_offers_applied": true,
