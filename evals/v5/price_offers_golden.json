{
  "baseline": 9,
  "description": "Price offers golden: deterministic sums and meta (price_offer_ids). Demo client, E2E_USE_TEST_CLIENT=1. v5 format — amounts via signals, not template phrases.",
  "cases": [
    {
      "id": "offers_classic_three_brands",
      "client_id": "demo",
      "question": "Сколько стоит один имплант под ключ с коронкой?",
      "expected_route_any": ["price_lookup", "retrieval_chunk", "catalog_md_first"],
      "expected_service_id_any": ["classic", "one_stage"],
      "expected_price_offer_brands": ["Implantium", "Impro", "Nobel Biocare"],
      "answer_signals_any": ["76 200", "85 200", "101 200", "₽"],
      "expected_price_unit": "one_tooth",
      "expected_price_offers_applied": true,
      "expected_price_offer_ids": [
        "classic.one_tooth.implantium",
        "classic.one_tooth.impro",
        "classic.one_tooth.nobel"
      ],
      "coverage_class": "STRONG"
    },
    {
      "id": "offers_classic_nobel_only",
      "client_id": "demo",
      "question": "Сколько стоит имплант Nobel Biocare под ключ на один зуб?",
