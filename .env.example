# Set to 1 for emergency fallback to v4 logic (classify_intent only); default 0 keeps Resolver on.
RESOLVER_OFF=0

# PERF-4: parallel Ingress+Planner speculative compute -- a deployment-level operational
# setting, not tied to any specific client_id/service. Default 0 = inert (Ingress and
# Planner run sequentially, byte-for-byte the pre-PERF-4 behavior). Safe range 0-4;
# invalid or negative values fail safe to 0 (logged); values above 4 are clamped to 4
# (logged) -- never silently accepted at face value. Real activation is a separate,
# explicit deployment decision: set this to a positive integer only after the owner has
# decided to turn parallel compute on for that specific running process.
# PLANNER_SPECULATION_CAPACITY=0

# Multiclient (локалка и VPS). Индекс и SQLite — в data/{client_id}/.
ALLOWED_CLIENTS=demo,cesi,nikadent
DEFAULT_CLIENT_ID=demo

# PostgreSQL для admin_dashboard (Phase M4). Локально: docker compose up -d postgres
BOT_PG_DSN=postgresql://bot:bot@localhost:5432/bot_events
# Disposable integration tests only (name must contain "test"; never use production BOT_PG_DSN):
# BOT_TEST_PG_DSN=postgresql://bot:bot@localhost:5432/bot_events_test
# Runtime vs migrator roles: see migrations/postgresql/roles_template.sql

# Observability retention: purge sid when last event older than N hours (0 = disable)
BOT_OBSERVABILITY_RETENTION_HOURS=168
BOT_OBSERVABILITY_RETENTION_INTERVAL_SEC=3600

# Local file logs (logs/*.jsonl): delete files older than N days on app start (0 = disable)
BOT_LOG_RETENTION_DAYS=7

# --- LLM: Qwen chat (pilot defaults in config.py) ---
# build_index.py validates local Markdown only (no remote embedding calls).
# DashScope / Qwen Cloud — chat, классификаторы, rerank (OpenAI-compatible API)
DASHSCOPE_API_KEY=
# Персональный MaaS endpoint (консоль Alibaba) или общий:
# CHAT_BASE_URL=https://ws-XXXX.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
CHAT_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_ENABLE_THINKING=0
# MODEL_CHAT=qwen3.7-plus
# Active sales-fast / One Call provider snapshot (default qwen3.7-plus-2026-05-26)
# SALES_ONE_PLUS_MODEL=qwen3.7-plus-2026-05-26
# Sales-fast One Call provider timeout in seconds (default 40; does not change LLM_REQUEST_TIMEOUT_SEC)
# SALES_ONE_PLUS_TIMEOUT_SEC=40
# MODEL_ARBITER=qwen3.7-plus
# MODEL_RESOLVER=qwen3.7-plus
# MODEL_QUERY_REWRITE=qwen3.7-plus
# MODEL_EMBED=text-embedding-3-large

# Оценка стоимости LLM в admin (USD за 1M токенов). 0 = не считать USD.
# qwen3.7-plus: 0.40 / 1.60 · qwen3.6-flash: 0.25 / 1.50 (docs.qwencloud.com)
BOT_LLM_USD_PER_1M_PROMPT=0.40
BOT_LLM_USD_PER_1M_COMPLETION=1.60

# SMTP — отправка заявок (cesi / nikadent). Секреты только здесь, не в git.
# Получатели писем — в clients/{id}/lead_config.yaml → recipients
SMTP_HOST=mail.artgents.ru
SMTP_PORT=465
SMTP_USE_SSL=1
SMTP_USE_TLS=0
SMTP_USER=bot@artgents.ru
SMTP_PASSWORD=
SMTP_FROM=bot@artgents.ru
