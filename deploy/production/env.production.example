# External production env file (never commit). Used only for Compose interpolation and selective service env.
# Pin verified image tags/digests on the VPS before first deploy (Pass 3 does not pull images).

BOT_IMAGE=
POSTGRES_IMAGE=
CADDY_IMAGE=

# PostgreSQL container bootstrap only (not bot/admin/migrator application secrets beyond connection targets).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# One-shot migrator (DDL + ledger) — not passed to bot/admin/caddy.
BOT_MIGRATOR_PG_DSN=

# Runtime observability role — bot + admin only.
BOT_PG_DSN=

# Multiclient registry (must match published clinic hostnames and on-disk packs).
ALLOWED_CLIENTS=
DEFAULT_CLIENT_ID=

# Qwen / DashScope runtime (bot only).
DASHSCOPE_API_KEY=
CHAT_BASE_URL=
CHAT_API_KEY=
QWEN_ENABLE_THINKING=

# SMTP (bot only).
SMTP_HOST=
SMTP_PORT=
SMTP_USE_SSL=
SMTP_USE_TLS=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Admin dashboard token (admin app + Caddy header injection; never in Git).
ADMIN_DASHBOARD_TOKEN=

# Caddy TLS + private admin Basic Auth (Caddy only).
CADDY_ACME_EMAIL=
CADDY_ADMIN_BASIC_AUTH_USER=
# BCrypt hash is generated on the VPS (caddy hash-password or equivalent), never stored in Git.
# Compose/dotenv treat `$` as interpolation — wrap the hash in single quotes in production.env, e.g.:
# CADDY_ADMIN_BASIC_AUTH_HASH='$2a$14$PLACEHOLDER_NOT_A_REAL_HASH'
CADDY_ADMIN_BASIC_AUTH_HASH=

# Optional tuning
GUNICORN_THREADS=
ADMIN_GUNICORN_THREADS=
BOT_OBSERVABILITY_RETENTION_HOURS=
BOT_OBSERVABILITY_RETENTION_INTERVAL_SEC=
BOT_LOG_RETENTION_DAYS=
BOT_LLM_USD_PER_1M_PROMPT=
BOT_LLM_USD_PER_1M_COMPLETION=
