    },
    {
      "id": "planner_negative_veneers_after_classic",
      "client_id": "demo",
      "history": [{"question": "Сколько стоит классический имплант?"}],
      "question": "а виниры сколько?",
      "expected_route_any": ["retrieval_chunk", "catalog_md_first", "price_lookup"],
      "must_contain": ["винир"],
      "must_not_contain": ["имплант под ключ"],
      "comment": "negative: explicit other service after price turn",
      "testability": "medium"
