.env
.env.*
!.env.example

__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
*.egg-info/
dist/
build/

# Индекс и сессии (пересобираются локально)
data/embeddings.npy
data/sessions/
data/bot.db
data/bot.db-*
data/*/bot.db
data/*/bot.db-*

# Локальные логи (вся папка, включая ротацию *.jsonl.*)
logs/

# Черновики и отладочный инспектор — не в репозиторий демо
drafts/
static/debug/

# Лиды с диска (демо не пишет, на всякий случай)
leads/

# Резервные копии редактора
.history/

# Eval run-dumps (локальные артефакты прогонов; уже отслеживаемые в git не снимаются)
eval_*.txt

# IDE и инструменты разработки
.claude/
.pytest_tmp*/
artgents-release-*.tar.gz

# Shared agent rules are tracked. Other local Codex state is ignored.
.codex/*
!.codex/agents/
!.codex/agents/checker.toml

.DS_Store
Thumbs.db
